# Environment variables for the backend application
DB_USER=Database_user_here
DB_HOST=Database_host_here
DB_NAME=Database_name_here
DB_PASSWORD="Database Passweod here"
DB_PORT=Database_port_here

# Environment variable for the server port for frontend, different from the database port to avoid conflicts and errors.
PORT=Your port number

# Variable for the JWT secret key used for signing and verifying JSON Web Tokens.
JWT_SECRET="Your secret here"
JWT_EXPIRATION_TIME='2h'
